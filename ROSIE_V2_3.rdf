    <!-- http://www.semanticweb.org/ontologies/2024/8/ROSIE#isMeasuredAs -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/ontologies/2024/8/ROSIE#isMeasuredAs">
