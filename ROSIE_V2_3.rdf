        <rdfs:range rdf:resource="http://www.semanticweb.org/ontologies/2024/8/ROSIE#AccessKind"/>
        <rdfs:comment>Access isDirectedBy AccessKind</rdfs:comment>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/ontologies/2024/8/ROSIE#isDivividedIn -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/ontologies/2024/8/ROSIE#isDivividedIn">
