    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Classes
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://www.semanticweb.org/ontologies/2024/8/ROSIE#Access -->

    <owl:Class rdf:about="http://www.semanticweb.org/ontologies/2024/8/ROSIE#Access">
        <rdfs:comment>Access: is a means of entering an Area. An access may represent a connection between Areas. It has a name, a direction (AccessKind) and a Pose.</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/ontologies/2024/8/ROSIE#AccessKind -->

    <owl:Class rdf:about="http://www.semanticweb.org/ontologies/2024/8/ROSIE#AccessKind">
        <rdfs:comment>AccessKind: defines the direction of an Access: IN (only entrance) OUT (only exit) or IN_OUT (both entrance and exit).</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/ontologies/2024/8/ROSIE#Actuating -->

    <owl:Class rdf:about="http://www.semanticweb.org/ontologies/2024/8/ROSIE#Actuating">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.semanticweb.org/ontologies/2024/8/ROSIE#PrimitiveSkill"/>
                    <owl:Class>
                        <owl:complementOf rdf:resource="http://www.semanticweb.org/ontologies/2024/8/ROSIE#Cognition"/>
                    </owl:Class>
                    <owl:Class>
                        <owl:complementOf rdf:resource="http://www.semanticweb.org/ontologies/2024/8/ROSIE#Sensing"/>
                    </owl:Class>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/ontologies/2024/8/ROSIE#PrimitiveSkill"/>
        <rdfs:comment>Actuating: is a PrimitiveSkill related to act and modify the environment. Examples: speak.</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/ontologies/2024/8/ROSIE#Area -->

    <owl:Class rdf:about="http://www.semanticweb.org/ontologies/2024/8/ROSIE#Area">
        <rdfs:comment>Area: represents the parts of a Scenario. It may be composed of another Area (subarea) and has one or more Access. 

Examples of Areas in a DomesticScenario are bedroom, dining room, living room, and kitchen. 

Examples of Area in a PublicScenario are reception, and rooms in a hotel. In this, the room may be composed of a bedroom and a bathroom (both are represented as Area in the ontology). Other examples of Area in a PublicScenario are the kitchen and the lounge of a restaurant. An Area has a name, a wallHeight (in meters), the coordinates of an uppeRightCorner and a bottomLeftCorner forming a rectangle that represents the Area. Besides, an Area also has a Pose.</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/ontologies/2024/8/ROSIE#BoundBox -->

    <owl:Class rdf:about="http://www.semanticweb.org/ontologies/2024/8/ROSIE#BoundBox">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.semanticweb.org/ontologies/2024/8/ROSIE#PositionRegion"/>
                    <owl:Class>
                        <owl:complementOf rdf:resource="http://www.semanticweb.org/ontologies/2024/8/ROSIE#RelativeRegion"/>
                    </owl:Class>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/ontologies/2024/8/ROSIE#PositionRegion"/>
        <owl:disjointWith rdf:resource="http://www.semanticweb.org/ontologies/2024/8/ROSIE#RelativeRegion"/>
        <rdfs:comment>BoundBox: is a PositionRegion (CORA), i.e., a set of position points in a given coordinate system, delimited by a rectangle surrounding an Element.</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/ontologies/2024/8/ROSIE#Capability -->

    <owl:Class rdf:about="http://www.semanticweb.org/ontologies/2024/8/ROSIE#Capability">
        <owl:equivalentClass rdf:resource="http://www.semanticweb.org/ontologies/2024/8/ROSIE#SingleStep"/>
        <rdfs:comment>Capability: is the combination of behaviors, robot parts, and organization that delivers a specified outcome. A capability specifies WHAT the robot can deliver without defining HOW to do it.</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/ontologies/2024/8/ROSIE#CategoryAgent -->

    <owl:Class rdf:about="http://www.semanticweb.org/ontologies/2024/8/ROSIE#CategoryAgent">
        <rdfs:comment>Role: defines the purpose/position of an Agent in the Area, e.g. a resident of a house, an elderly person, a nurse caring for an elderly person, a housekeeper. Each role is associated with one or more Privilege (PrivilegeKind).</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/ontologies/2024/8/ROSIE#CategoryObject -->

    <owl:Class rdf:about="http://www.semanticweb.org/ontologies/2024/8/ROSIE#CategoryObject">
        <rdfs:comment xml:lang="home domain are bed, couch, table, chair, trash bins, television, cupboard, bookcase, coat rack, dishwasher, sink and powered refrigerator; - decoration, scenarioobject used to decorate the area, e.g. a plant jar; - tableware, dish, bowl, cup, and napkin;  - cutlery, fork, knife, and spoon;  - trash bags, big plastic trash bags, preferably with handles; - bags, lightweight with stiff, vertical handles; - trays, tray or basket, intended for two-handed manipulation; - pourable, an object whose content can be poured, e.g., jug; - heavy object, weight between 1.0kg and 1.5kg ,e.g., water bottle; - tiny object, a lightweight object, no bigger than 5cm, e.g., teabag; - fragile object, an easy-to-break object, e.g., egg; - deformable object, a flexible object that may appear in different shapes, e.g., cloth.">CategoryKind: classifies a ScenarioObject according to its type as: 

- Furniture, ScenarioObject that the service robot does not intend to move during a task. Examples of furniture in the RoboCup</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/ontologies/2024/8/ROSIE#Cognition -->

    <owl:Class rdf:about="http://www.semanticweb.org/ontologies/2024/8/ROSIE#Cognition">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.semanticweb.org/ontologies/2024/8/ROSIE#PrimitiveSkill"/>
                    <owl:Class>
                        <owl:complementOf rdf:resource="http://www.semanticweb.org/ontologies/2024/8/ROSIE#Actuating"/>
                    </owl:Class>
                    <owl:Class>
                        <owl:complementOf rdf:resource="http://www.semanticweb.org/ontologies/2024/8/ROSIE#Sensing"/>
                    </owl:Class>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/ontologies/2024/8/ROSIE#PrimitiveSkill"/>
        <rdfs:comment>Cognition: is a PrimitiveSkill related to data processing. Examples: Robot training and face recognition.</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/ontologies/2024/8/ROSIE#ComposedStep -->

    <owl:Class rdf:about="http://www.semanticweb.org/ontologies/2024/8/ROSIE#ComposedStep">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.semanticweb.org/ontologies/2024/8/ROSIE#Step"/>
                    <owl:Class>
                        <owl:complementOf rdf:resource="http://www.semanticweb.org/ontologies/2024/8/ROSIE#SingleStep"/>
                    </owl:Class>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/ontologies/2024/8/ROSIE#Step"/>
        <rdfs:comment>ComposedStep: is a Step composed of other Steps. The composition of steps must end in a SingleStep.</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/ontologies/2024/8/ROSIE#Contract -->

    <owl:Class rdf:about="http://www.semanticweb.org/ontologies/2024/8/ROSIE#Contract">
        <rdfs:comment>Contract: establishes an agreement between a PrimitiveActions and a ServiceRobotPart. It links a specific PrimitiveAction to the necessary parts for its implementation, i.e., there should be a Contract relating the PrimiviteAction to the ServiceRobotParts required so that the PrimitiveAction can be implemented/executed by a ServiceRobot that has that ServiceRobotParts. 

A PrimitiveAction may require n parts. For each part, a contract is defined. In a Contract, the PrimitiveAction and the ServiceRobotPart&apos;s non-functional requirements must be compatible* (Match).  Examples: (i) a SoftwarePart that executes in 0.5s is compatible with a PrimitiveAction that requires execution in a maximum of 1s; (ii) A camera (RobotSensingPart) that provides an image at 10 frames/s is compatible with a PrimitiveAction that requires an image at least 5 frames/s; (iii) a DevicePart that uses a maximum of 50mA is compatible with a PrimitiveAction that requires up to 70mA.</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/ontologies/2024/8/ROSIE#DevicePart -->

    <owl:Class rdf:about="http://www.semanticweb.org/ontologies/2024/8/ROSIE#DevicePart">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.semanticweb.org/ontologies/2024/8/ROSIE#ServiceRobotPart"/>
                    <owl:Class>
                        <owl:complementOf rdf:resource="http://www.semanticweb.org/ontologies/2024/8/ROSIE#SoftwarePart"/>
                    </owl:Class>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/ontologies/2024/8/ROSIE#ServiceRobotPart"/>
        <rdfs:comment>DevicePart:  represents the hardware parts (RobotPart in CORA) of a service robot, i.e. a RobotProcessingPart (CORA), a RobotSenssingPart (CORA), a RobotActuatingPart (CORA) or a RobotCommunicatingPart (CORA).</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/ontologies/2024/8/ROSIE#DomesticScenario -->

    <owl:Class rdf:about="http://www.semanticweb.org/ontologies/2024/8/ROSIE#DomesticScenario">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.semanticweb.org/ontologies/2024/8/ROSIE#Scenario"/>
                    <owl:Class>
                        <owl:complementOf rdf:resource="http://www.semanticweb.org/ontologies/2024/8/ROSIE#PublicScenario"/>
                    </owl:Class>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/ontologies/2024/8/ROSIE#Scenario"/>
        <rdfs:comment xml:lang="home, or a real-world house.">DomesticScenario: is a Scenario in a typical domestic setting, e.g., an arena of the RoboCup</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/ontologies/2024/8/ROSIE#Door -->

    <owl:Class rdf:about="http://www.semanticweb.org/ontologies/2024/8/ROSIE#Door">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.semanticweb.org/ontologies/2024/8/ROSIE#Access"/>
                    <owl:Class>
                        <owl:complementOf rdf:resource="http://www.semanticweb.org/ontologies/2024/8/ROSIE#Lift"/>
                    </owl:Class>
                    <owl:Class>
                        <owl:complementOf rdf:resource="http://www.semanticweb.org/ontologies/2024/8/ROSIE#Ramp"/>
                    </owl:Class>
                    <owl:Class>
                        <owl:complementOf rdf:resource="http://www.semanticweb.org/ontologies/2024/8/ROSIE#Stair"/>
                    </owl:Class>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/ontologies/2024/8/ROSIE#Access"/>
        <rdfs:comment>Door: is a kind of Access that can be opened or closed. A Door may have a handle (hasHandle attribute) and has a state indicating if it is opened or closed (isOpen attribute).

- hasOpenningDevice: when true, it indicates that there is a device (e.g., a handle or a button) that can be used to open the door; otherwise, there isn&apos;t such a device.
- isOpen: when true, indicates that the door is open, otherwise the door is closed.</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/ontologies/2024/8/ROSIE#Element -->

    <owl:Class rdf:about="http://www.semanticweb.org/ontologies/2024/8/ROSIE#Element">
        <rdfs:comment>Element: extends Object (“normal physical objects” - SUMO) and is anything or anybody inside an Area. An Element has a Pose and the timestamp with the last time the pose was captured. Besides, an Element has a recognitionLevel that represents the probability of recognition by a service robot: zero means unrecognizable, and one means fully recognizable. Usually, the recognition probability is directly related to the amount of information that the service robot has about the element. Elements can be of two types: Agent or ScenarioObject.

Ex.: Consider a receptionist robot welcoming a guest at a hotel. Initially, the robot knows nothing about the guest, but identifies him as a person. In this case the recognitionLevel is set to a value near to zero. Over time, the robot stores features of this person, e.g. cloth color, to direct its service to that person, so the recognitionLevel is increased as the amount of information (that can be used to recognize the person) increases. When the guest checks in, he provides some data, such as biometrics, thus, the robot can precisely identify him, the recognitionLevel is set to a value near one. In this way, the recognitionLevel of a person increases over time; thus, his/her recognition is more likely.</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/ontologies/2024/8/ROSIE#ElementThatHasPose -->

    <owl:Class rdf:about="http://www.semanticweb.org/ontologies/2024/8/ROSIE#ElementThatHasPose">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.semanticweb.org/ontologies/2024/8/ROSIE#Element"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://www.semanticweb.org/ontologies/2024/8/ROSIE#isPositionedPElem"/>
                        <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/ontologies/2024/8/ROSIE#Pose"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:comment>Which element has pose?</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/ontologies/2024/8/ROSIE#ExecutionPlan -->

    <owl:Class rdf:about="http://www.semanticweb.org/ontologies/2024/8/ROSIE#ExecutionPlan">
        <rdfs:comment>ExecutionPlan: is an arrangement of steps for Task execution. In this arrangement, Steps can be orchestrated in parallel or sequentially using, for example, a behavior tree or UML state machine.</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/ontologies/2024/8/ROSIE#ExtraFeature -->

    <owl:Class rdf:about="http://www.semanticweb.org/ontologies/2024/8/ROSIE#ExtraFeature">
        <rdfs:comment>ExtraFeature: is any extra feature modeled to represent information of an Element that is not explicitly defined in the current version of the ontology. Examples of ExtraFeature for a Person are his cloth color and gender. Examples of ExtraFeature for a ScenarioObject are its color and texture.</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/ontologies/2024/8/ROSIE#Goal -->

    <owl:Class rdf:about="http://www.semanticweb.org/ontologies/2024/8/ROSIE#Goal"/>
    


    <!-- http://www.semanticweb.org/ontologies/2024/8/ROSIE#Lift -->

    <owl:Class rdf:about="http://www.semanticweb.org/ontologies/2024/8/ROSIE#Lift">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.semanticweb.org/ontologies/2024/8/ROSIE#Access"/>
                    <owl:Class>
                        <owl:complementOf rdf:resource="http://www.semanticweb.org/ontologies/2024/8/ROSIE#Door"/>
                    </owl:Class>
                    <owl:Class>
                        <owl:complementOf rdf:resource="http://www.semanticweb.org/ontologies/2024/8/ROSIE#Ramp"/>
                    </owl:Class>
                    <owl:Class>
                        <owl:complementOf rdf:resource="http://www.semanticweb.org/ontologies/2024/8/ROSIE#Stair"/>
                    </owl:Class>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/ontologies/2024/8/ROSIE#Access"/>
        <rdfs:comment>Lift: is a kind of Access that is a transportation device like a box that moves up and down. It has a capacity indicating the maximum weight supported.</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/ontologies/2024/8/ROSIE#MaterialKind -->

    <owl:Class rdf:about="http://www.semanticweb.org/ontologies/2024/8/ROSIE#MaterialKind">
        <rdfs:comment>MaterialKind: is the physical substance that the object is made from, e.g., plastic, metal, wood.</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/ontologies/2024/8/ROSIE#OrientationMeasure -->

    <owl:Class rdf:about="http://www.semanticweb.org/ontologies/2024/8/ROSIE#OrientationMeasure">
        <rdfs:comment>Orientation Measure (CORA): is essentially a measure (or observation) attributed to the orientation of a given (physical) object. In this context, orientation denotes the information regarding where the object is pointing to in relation to the reference object of the orientation coordinate system</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/ontologies/2024/8/ROSIE#PartConnection -->

    <owl:Class rdf:about="http://www.semanticweb.org/ontologies/2024/8/ROSIE#PartConnection">
        <rdfs:comment>PartConnection: is a connection (physical or logical) between two RobotPart. 

For example, the connection of a RobotSensingPart (e.g. a camera) with a RobotPart (e.g. chassis), e.g. in Gazebo simulator called Joint;  the connection of a SoftwarePart (e.g. a library) with a RobotSensingPart (e.g. camera), in Gazebo Simulator called Plugin.</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/ontologies/2024/8/ROSIE#Person -->

    <owl:Class rdf:about="http://www.semanticweb.org/ontologies/2024/8/ROSIE#Person">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/ontologies/2024/8/ROSIE#ScenarioAgent"/>
        <rdfs:comment>Person: specializes Agent and represents a human being participating in the Scenario. During a person&apos;s lifetime some feature can be set to enable his/her recognition.</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/ontologies/2024/8/ROSIE#Pose -->

    <owl:Class rdf:about="http://www.semanticweb.org/ontologies/2024/8/ROSIE#Pose">
        <rdfs:comment>Pose (CORA): “A position and an orientation constitute a pose. The pose of an object is the description of any position and orientation measurements of that object. “</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/ontologies/2024/8/ROSIE#PoseOfElement -->

    <owl:Class rdf:about="http://www.semanticweb.org/ontologies/2024/8/ROSIE#PoseOfElement">
        <owl:equivalentClass>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/ontologies/2024/8/ROSIE#posesElem"/>
                <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/ontologies/2024/8/ROSIE#Element"/>
            </owl:Restriction>
        </owl:equivalentClass>
        <rdfs:comment>Pose of each element</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/ontologies/2024/8/ROSIE#PositionMeasure -->

    <owl:Class rdf:about="http://www.semanticweb.org/ontologies/2024/8/ROSIE#PositionMeasure">
        <rdfs:comment>Position Measure (CORA): “A measure (SUMO) attributed to a (physical) object (SUMO) describing its position. A position can be described by a point or a region. For instance, one can describe a robot as positioned at coordinates (x, y) in the coordinate system, or at the front of the box, where ‘front’ comprises a conical region centered on the box and pointed forward.”</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/ontologies/2024/8/ROSIE#PositionPoint -->

    <owl:Class rdf:about="http://www.semanticweb.org/ontologies/2024/8/ROSIE#PositionPoint">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.semanticweb.org/ontologies/2024/8/ROSIE#PositionMeasure"/>
                    <owl:Class>
                        <owl:complementOf rdf:resource="http://www.semanticweb.org/ontologies/2024/8/ROSIE#PositionRegion"/>
                    </owl:Class>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/ontologies/2024/8/ROSIE#PositionMeasure"/>
        <rdfs:comment>Position point (CORA): “A point in a position coordinate system. It denotes a precise indication of position of a given object. Position points are always defined in a single coordinate system.”</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/ontologies/2024/8/ROSIE#PositionRegion -->

    <owl:Class rdf:about="http://www.semanticweb.org/ontologies/2024/8/ROSIE#PositionRegion">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.semanticweb.org/ontologies/2024/8/ROSIE#PositionMeasure"/>
                    <owl:Class>
                        <owl:complementOf rdf:resource="http://www.semanticweb.org/ontologies/2024/8/ROSIE#PositionPoint"/>
                    </owl:Class>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/ontologies/2024/8/ROSIE#PositionMeasure"/>
        <rdfs:comment>Position Region (CORA): “An abstract region in a position coordinate system. More specifically, a position region is defined by position points in a given coordinate system. It defines qualitative positions such as ‘left of’, ‘in front of’, ‘on top of’, etc. These expressions define regions in relation to a reference object in which other objects are placed. A position region is always generated by a given spatial operator applied to a list of reference objects.”</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/ontologies/2024/8/ROSIE#PrimitiveSkill -->

    <owl:Class rdf:about="http://www.semanticweb.org/ontologies/2024/8/ROSIE#PrimitiveSkill">
        <rdfs:comment>PrimitiveSkill:  consists of using service robot parts to produce a specific result. A PrimitiveSkill is a behavior ATOMIC STAGE, i.e., it CAN NOT be composed by other PrimitiveSkill.</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/ontologies/2024/8/ROSIE#PrivilegeKind -->

    <owl:Class rdf:about="http://www.semanticweb.org/ontologies/2024/8/ROSIE#PrivilegeKind">
        <rdfs:comment>PrivilegeKind: defines a Person&apos;s special rights, advantage, or immunity granted when interacting with the ServiceRobot. The Person&apos;s rights are the command levels over the behavior or tasks the robot can perform. For example: in a DomesticScenario, a Person with the GUEST privilege interacts with the ServiceRobot, but does not have permission to operate it; a Person with the HOST privilege has permission to give orders/commands to the ServiceRobot.</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/ontologies/2024/8/ROSIE#PublicScenario -->

    <owl:Class rdf:about="http://www.semanticweb.org/ontologies/2024/8/ROSIE#PublicScenario">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.semanticweb.org/ontologies/2024/8/ROSIE#Scenario"/>
                    <owl:Class>
                        <owl:complementOf rdf:resource="http://www.semanticweb.org/ontologies/2024/8/ROSIE#DomesticScenario"/>
                    </owl:Class>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/ontologies/2024/8/ROSIE#Scenario"/>
        <rdfs:comment>PublicScenario: is a non-structured place, such as, a restaurant, a hotel or a supermarket.</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/ontologies/2024/8/ROSIE#QualitativePosKind -->

    <owl:Class rdf:about="http://www.semanticweb.org/ontologies/2024/8/ROSIE#QualitativePosKind">
        <rdfs:comment>QualitativePosKind: represents a domain for possible relative positions. Examples are LEFT, RIGHT, ONTOP, BELOW.</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/ontologies/2024/8/ROSIE#Ramp -->

    <owl:Class rdf:about="http://www.semanticweb.org/ontologies/2024/8/ROSIE#Ramp">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.semanticweb.org/ontologies/2024/8/ROSIE#Access"/>
                    <owl:Class>
                        <owl:complementOf rdf:resource="http://www.semanticweb.org/ontologies/2024/8/ROSIE#Door"/>
                    </owl:Class>
                    <owl:Class>
                        <owl:complementOf rdf:resource="http://www.semanticweb.org/ontologies/2024/8/ROSIE#Lift"/>
                    </owl:Class>
                    <owl:Class>
                        <owl:complementOf rdf:resource="http://www.semanticweb.org/ontologies/2024/8/ROSIE#Stair"/>
                    </owl:Class>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/ontologies/2024/8/ROSIE#Access"/>
        <rdfs:comment>Ramp: is a slope or inclined plane for joining two different levels. Slope can be expressed in angles, gradients or grades.</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/ontologies/2024/8/ROSIE#RelativeRegion -->

    <owl:Class rdf:about="http://www.semanticweb.org/ontologies/2024/8/ROSIE#RelativeRegion">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.semanticweb.org/ontologies/2024/8/ROSIE#PositionRegion"/>
                    <owl:Class>
                        <owl:complementOf rdf:resource="http://www.semanticweb.org/ontologies/2024/8/ROSIE#BoundBox"/>
                    </owl:Class>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/ontologies/2024/8/ROSIE#PositionRegion"/>
        <rdfs:comment>RelativeRegion: is a PositionRegion (CORA) indicating a qualitative position about a referenced Element. Possible qualitative positions are predefined in the QualitativePosKind.</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/ontologies/2024/8/ROSIE#Requirement -->

    <owl:Class rdf:about="http://www.semanticweb.org/ontologies/2024/8/ROSIE#Requirement">
        <rdfs:comment>Requirement:  represents a proposition (SUMO) that must be fulfilled. It has a description of its purpose, a type (reqType), belongs to a domain (reqDomain), and is specialized in PartRequirement and CapabilityRequirement.</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/ontologies/2024/8/ROSIE#RequirementDomainKind -->

    <owl:Class rdf:about="http://www.semanticweb.org/ontologies/2024/8/ROSIE#RequirementDomainKind">
        <rdfs:comment>RequirementDomainKind: represents the requirement domain, e.g., usability, time (execution time), or distance (minimal distance, e.g., to see or hear).</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/ontologies/2024/8/ROSIE#RequirementTypeKind -->

    <owl:Class rdf:about="http://www.semanticweb.org/ontologies/2024/8/ROSIE#RequirementTypeKind">
        <rdfs:comment>RequirementTypeKind: indicates whenever it refers to a functional or non-functional requirement.</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/ontologies/2024/8/ROSIE#RobotActuatingPart -->

    <owl:Class rdf:about="http://www.semanticweb.org/ontologies/2024/8/ROSIE#RobotActuatingPart">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.semanticweb.org/ontologies/2024/8/ROSIE#DevicePart"/>
                    <owl:Class>
                        <owl:complementOf rdf:resource="http://www.semanticweb.org/ontologies/2024/8/ROSIE#RobotCommunicatingPart"/>
                    </owl:Class>
                    <owl:Class>
                        <owl:complementOf rdf:resource="http://www.semanticweb.org/ontologies/2024/8/ROSIE#RobotProcessingPart"/>
                    </owl:Class>
                    <owl:Class>
                        <owl:complementOf rdf:resource="http://www.semanticweb.org/ontologies/2024/8/ROSIE#RobotSensingPart"/>
                    </owl:Class>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/ontologies/2024/8/ROSIE#DevicePart"/>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/ontologies/2024/8/ROSIE#RobotCommunicatingPart -->

    <owl:Class rdf:about="http://www.semanticweb.org/ontologies/2024/8/ROSIE#RobotCommunicatingPart">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.semanticweb.org/ontologies/2024/8/ROSIE#DevicePart"/>
                    <owl:Class>
                        <owl:complementOf rdf:resource="http://www.semanticweb.org/ontologies/2024/8/ROSIE#RobotActuatingPart"/>
                    </owl:Class>
                    <owl:Class>
                        <owl:complementOf rdf:resource="http://www.semanticweb.org/ontologies/2024/8/ROSIE#RobotProcessingPart"/>
                    </owl:Class>
                    <owl:Class>
                        <owl:complementOf rdf:resource="http://www.semanticweb.org/ontologies/2024/8/ROSIE#RobotSensingPart"/>
                    </owl:Class>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/ontologies/2024/8/ROSIE#DevicePart"/>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/ontologies/2024/8/ROSIE#RobotProcessingPart -->

    <owl:Class rdf:about="http://www.semanticweb.org/ontologies/2024/8/ROSIE#RobotProcessingPart">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.semanticweb.org/ontologies/2024/8/ROSIE#DevicePart"/>
                    <owl:Class>
                        <owl:complementOf rdf:resource="http://www.semanticweb.org/ontologies/2024/8/ROSIE#RobotActuatingPart"/>
                    </owl:Class>
                    <owl:Class>
                        <owl:complementOf rdf:resource="http://www.semanticweb.org/ontologies/2024/8/ROSIE#RobotCommunicatingPart"/>
                    </owl:Class>
                    <owl:Class>
                        <owl:complementOf rdf:resource="http://www.semanticweb.org/ontologies/2024/8/ROSIE#RobotSensingPart"/>
                    </owl:Class>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/ontologies/2024/8/ROSIE#DevicePart"/>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/ontologies/2024/8/ROSIE#RobotSensingPart -->

    <owl:Class rdf:about="http://www.semanticweb.org/ontologies/2024/8/ROSIE#RobotSensingPart">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.semanticweb.org/ontologies/2024/8/ROSIE#DevicePart"/>
                    <owl:Class>
                        <owl:complementOf rdf:resource="http://www.semanticweb.org/ontologies/2024/8/ROSIE#RobotActuatingPart"/>
                    </owl:Class>
                    <owl:Class>
                        <owl:complementOf rdf:resource="http://www.semanticweb.org/ontologies/2024/8/ROSIE#RobotCommunicatingPart"/>
                    </owl:Class>
                    <owl:Class>
                        <owl:complementOf rdf:resource="http://www.semanticweb.org/ontologies/2024/8/ROSIE#RobotProcessingPart"/>
                    </owl:Class>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/ontologies/2024/8/ROSIE#DevicePart"/>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/ontologies/2024/8/ROSIE#Scenario -->

    <owl:Class rdf:about="http://www.semanticweb.org/ontologies/2024/8/ROSIE#Scenario">
        <owl:equivalentClass>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/ontologies/2024/8/ROSIE#isComposedOf"/>
                <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/ontologies/2024/8/ROSIE#Area"/>
            </owl:Restriction>
        </owl:equivalentClass>
        <rdfs:comment>Scenario: is a place where a ServiceRobot performs tasks. It contains at least one Area. A Scenario can be of two types: DomesticScenario or PublicScenario.</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/ontologies/2024/8/ROSIE#ScenarioAgent -->

    <owl:Class rdf:about="http://www.semanticweb.org/ontologies/2024/8/ROSIE#ScenarioAgent">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.semanticweb.org/ontologies/2024/8/ROSIE#Element"/>
                    <owl:Class>
                        <owl:complementOf rdf:resource="http://www.semanticweb.org/ontologies/2024/8/ROSIE#ScenarioObject"/>
                    </owl:Class>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/ontologies/2024/8/ROSIE#Element"/>
        <rdfs:comment>Agent (SUMO): “Something or someone that can act on its own and produce changes in the world”. An agent may interact with the service robot during a task.  Examples of agents are animals (e.g., a dog walking in the house) and other robots (e.g., a robot delivering a pizza). 

Agents are associated with Roles.</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/ontologies/2024/8/ROSIE#ScenarioObject -->

    <owl:Class rdf:about="http://www.semanticweb.org/ontologies/2024/8/ROSIE#ScenarioObject">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.semanticweb.org/ontologies/2024/8/ROSIE#Element"/>
                    <owl:Class>
                        <owl:complementOf rdf:resource="http://www.semanticweb.org/ontologies/2024/8/ROSIE#Person"/>
                    </owl:Class>
                    <owl:Class>
                        <owl:complementOf rdf:resource="http://www.semanticweb.org/ontologies/2024/8/ROSIE#ScenarioAgent"/>
                    </owl:Class>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/ontologies/2024/8/ROSIE#Element"/>
        <rdfs:comment>ScenarioObject: specializes Element and represents things arranged in an Area. A ScenarioObject has a description, a category (CategoryKind), weight, shape, can be deformable, and is made of a material (MaterialKind). 

- Weigh defines the object’s weight in grams, e.g., 30g.
- Shape defines the object’s volume in mash 3D
- IsDeformable indicates whether the object can be deformed (true) or not (false).
- Material defines the object’s material according to the MaterialKind domain.</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/ontologies/2024/8/ROSIE#Sensing -->

    <owl:Class rdf:about="http://www.semanticweb.org/ontologies/2024/8/ROSIE#Sensing">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.semanticweb.org/ontologies/2024/8/ROSIE#PrimitiveSkill"/>
                    <owl:Class>
                        <owl:complementOf rdf:resource="http://www.semanticweb.org/ontologies/2024/8/ROSIE#Actuating"/>
                    </owl:Class>
                    <owl:Class>
                        <owl:complementOf rdf:resource="http://www.semanticweb.org/ontologies/2024/8/ROSIE#Cognition"/>
                    </owl:Class>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/ontologies/2024/8/ROSIE#PrimitiveSkill"/>
        <rdfs:comment>Sensing: is a PrimitiveSkill related to sensing and capturing data from the environment. Examples are: see (capture a video) and hear (capture sounds).</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/ontologies/2024/8/ROSIE#ServiceRobot -->

    <owl:Class rdf:about="http://www.semanticweb.org/ontologies/2024/8/ROSIE#ServiceRobot">
        <owl:equivalentClass>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/ontologies/2024/8/ROSIE#hasComponent"/>
                <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/ontologies/2024/8/ROSIE#ServiceRobotPart"/>
            </owl:Restriction>
        </owl:equivalentClass>
        <rdfs:comment>ServiceRobot:  is a fully autonomous Robot (CORA) for personal or professional use that performs useful tasks for humans or equipment (ISO8373:2021). It may involve human interaction (ISO8373:2021) but does not allow human intervention. 

- Human Interaction (ISO8373:2021): “information and action exchanges between human and robot to perform a task by means of a user interface. Exchanges through vocal, visual and tactile means”. 
- Human intervention: external (remote or in-person) human control.
- Personal use: includes tasks related to personal assistance such as cooking, cleaning, carrying things, and handling or serving of items.
- Professional use includes tasks related to personal assistance in a non-structured environment, such as, serving dinner in a restaurant, welcoming a hotel guest.

A ServiceRobot has a name and a status, indicating whenever it is working, shutdown or charging.

* ServiceRobot does NOT include industrial robots, medical robots, or teleoperated robots. In some situations, a robot may assume more than one role, e.g., a hybrid ServiceRobot and teleoperated robot. Although this is possible, it is outside this ontology&apos;s scope. 
* This ontology does not consider Robot Group (CORA). Cooperation among robots to achieve a goal may be considered in future releases.</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/ontologies/2024/8/ROSIE#ServiceRobotBehavior -->

    <owl:Class rdf:about="http://www.semanticweb.org/ontologies/2024/8/ROSIE#ServiceRobotBehavior">
        <rdfs:comment>ServiceRobotBehavior: represents a capability realization according to a specific implementation strategy. It orchestrates the set of PrimitiveSkills necessary for a capability implementation. The orchestration consists of the coordination of PrimitiveSkills, i.e., involves the definition of a workflow or pipeline, with the PrimitiveSkills needed to perform the behavior. PrimitiveSkills can be orchestrated in parallel or sequentially using, for example, behavior tree or UML state machine.</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/ontologies/2024/8/ROSIE#ServiceRobotPart -->

    <owl:Class rdf:about="http://www.semanticweb.org/ontologies/2024/8/ROSIE#ServiceRobotPart">
        <rdfs:comment>ServiceRobotPart: represents the parts that compose a ServiceRobot. 

A ServiceRobotPart can be composed of another ServiceRobotPart (named subpart). 

A ServiceRobot may have hardware parts (DevicePart) or software parts (SoftwarePart). 

A part can be connected to other parts through the definition of PartConnection.</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/ontologies/2024/8/ROSIE#SingleStep -->

    <owl:Class rdf:about="http://www.semanticweb.org/ontologies/2024/8/ROSIE#SingleStep">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.semanticweb.org/ontologies/2024/8/ROSIE#Step"/>
                    <owl:Class>
                        <owl:complementOf rdf:resource="http://www.semanticweb.org/ontologies/2024/8/ROSIE#ComposedStep"/>
                    </owl:Class>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/ontologies/2024/8/ROSIE#Step"/>
        <rdfs:comment>SingleStep: is a Step that can not be composed of another Step (e.g. considering a tree, steps are the leaves of the tree). It refers to a Capacity.</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/ontologies/2024/8/ROSIE#SoftwarePart -->

    <owl:Class rdf:about="http://www.semanticweb.org/ontologies/2024/8/ROSIE#SoftwarePart">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.semanticweb.org/ontologies/2024/8/ROSIE#ServiceRobotPart"/>
                    <owl:Class>
                        <owl:complementOf rdf:resource="http://www.semanticweb.org/ontologies/2024/8/ROSIE#DevicePart"/>
                    </owl:Class>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/ontologies/2024/8/ROSIE#ServiceRobotPart"/>
        <rdfs:comment>SoftwarePart: is an abstract entity (SUMO) that represents the software components of a ServiceRobot, e.g., software functions, libraries, and applications.</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/ontologies/2024/8/ROSIE#Stair -->

    <owl:Class rdf:about="http://www.semanticweb.org/ontologies/2024/8/ROSIE#Stair">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.semanticweb.org/ontologies/2024/8/ROSIE#Access"/>
                    <owl:Class>
                        <owl:complementOf rdf:resource="http://www.semanticweb.org/ontologies/2024/8/ROSIE#Door"/>
                    </owl:Class>
                    <owl:Class>
                        <owl:complementOf rdf:resource="http://www.semanticweb.org/ontologies/2024/8/ROSIE#Lift"/>
                    </owl:Class>
                    <owl:Class>
                        <owl:complementOf rdf:resource="http://www.semanticweb.org/ontologies/2024/8/ROSIE#Ramp"/>
                    </owl:Class>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/ontologies/2024/8/ROSIE#Access"/>
        <rdfs:comment>Stair: is a kind of Access that connects lower and higher levels using steps.</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/ontologies/2024/8/ROSIE#StatusKind -->

    <owl:Class rdf:about="http://www.semanticweb.org/ontologies/2024/8/ROSIE#StatusKind"/>
    


    <!-- http://www.semanticweb.org/ontologies/2024/8/ROSIE#Step -->

    <owl:Class rdf:about="http://www.semanticweb.org/ontologies/2024/8/ROSIE#Step">
        <rdfs:comment>Step: represents a stage of the ExecutionPlan with a particular purpose. There are two types of Step: ComposedStep and SingleStep.</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/ontologies/2024/8/ROSIE#Task -->

    <owl:Class rdf:about="http://www.semanticweb.org/ontologies/2024/8/ROSIE#Task">
        <rdfs:comment>Task: represents the work performed by the ServiceRobot when serving a human. A Task has a name, a description, main goals (at least one), and may have optional goals. Tasks are performed in a set of steps organized as an ExecutionPlan.

- Name defines the task name, e.g., Receptionist. 
- Description gives a brief explanation of the task, e.g., “The robot has to take new guests to the living room to introduce them and offer a free place to sit”.
- Main goal: describes what the serviceRobot wants to achieve, e.g. “Introduce newcomers to a party and maintain appropriate gaze direction (at a person, the direction of navigation)”.
- Optional goal: adds optional purposes, e.g., “Open the entrance door for each arriving guest” and “Describe the guest for the other people”.</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/ontologies/2024/8/ROSIE#3DPoint -->

    <owl:Class rdf:about="http://www.semanticweb.org/ontologies/2024/8/ROSIE#3DPoint">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/ontologies/2024/8/ROSIE#PositionPoint"/>
        <rdfs:comment>3DPoint: is a 3D point in a position coordinate system indicating a specific location.</rdfs:comment>
    </owl:Class>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Individuals
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://www.semanticweb.org/ontologies/2024/8/ROSIE#access_diningKitchen -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/ontologies/2024/8/ROSIE#access_diningKitchen">
        <rdf:type rdf:resource="http://www.semanticweb.org/ontologies/2024/8/ROSIE#Access"/>
        <ROSIE1:isDirectedBy rdf:resource="http://www.semanticweb.org/ontologies/2024/8/ROSIE#inOut"/>
        <ROSIE1:name>dining inOut kitchen</ROSIE1:name>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/ontologies/2024/8/ROSIE#access_diningLiving -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/ontologies/2024/8/ROSIE#access_diningLiving">
        <rdf:type rdf:resource="http://www.semanticweb.org/ontologies/2024/8/ROSIE#Access"/>
        <ROSIE1:isDirectedBy rdf:resource="http://www.semanticweb.org/ontologies/2024/8/ROSIE#inOut"/>
        <ROSIE1:name>dining inOut living</ROSIE1:name>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/ontologies/2024/8/ROSIE#access_livingBedroom -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/ontologies/2024/8/ROSIE#access_livingBedroom">
        <rdf:type rdf:resource="http://www.semanticweb.org/ontologies/2024/8/ROSIE#Access"/>
        <ROSIE1:isDirectedBy rdf:resource="http://www.semanticweb.org/ontologies/2024/8/ROSIE#inOut"/>
        <ROSIE1:name>living inOut bedroom</ROSIE1:name>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/ontologies/2024/8/ROSIE#addNewFace -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/ontologies/2024/8/ROSIE#addNewFace">
        <rdf:type rdf:resource="http://www.semanticweb.org/ontologies/2024/8/ROSIE#ComposedStep"/>
        <ROSIE1:composes rdf:resource="http://www.semanticweb.org/ontologies/2024/8/ROSIE#giveInformation"/>
        <ROSIE1:composes rdf:resource="http://www.semanticweb.org/ontologies/2024/8/ROSIE#learnFace"/>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/ontologies/2024/8/ROSIE#arena2024 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/ontologies/2024/8/ROSIE#arena2024">
        <rdf:type rdf:resource="http://www.semanticweb.org/ontologies/2024/8/ROSIE#DomesticScenario"/>
        <ROSIE1:isComposedOf rdf:resource="http://www.semanticweb.org/ontologies/2024/8/ROSIE#bedRoom"/>
        <ROSIE1:isComposedOf rdf:resource="http://www.semanticweb.org/ontologies/2024/8/ROSIE#dining"/>
        <ROSIE1:isComposedOf rdf:resource="http://www.semanticweb.org/ontologies/2024/8/ROSIE#kitchen"/>
        <ROSIE1:isComposedOf rdf:resource="http://www.semanticweb.org/ontologies/2024/8/ROSIE#living"/>
        <ROSIE1:name>Arena Robotica 2024</ROSIE1:name>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/ontologies/2024/8/ROSIE#bedRoom -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/ontologies/2024/8/ROSIE#bedRoom">
        <rdf:type rdf:resource="http://www.semanticweb.org/ontologies/2024/8/ROSIE#Area"/>
        <ROSIE1:isAccessedBy rdf:resource="http://www.semanticweb.org/ontologies/2024/8/ROSIE#access_livingBedroom"/>
        <ROSIE1:isCategorizedCatObject rdf:resource="http://www.semanticweb.org/ontologies/2024/8/ROSIE#furniture"/>
        <ROSIE1:isPartOf rdf:resource="http://www.semanticweb.org/ontologies/2024/8/ROSIE#arena2024"/>
        <ROSIE1:isPositionedPArea rdf:resource="http://www.semanticweb.org/ontologies/2024/8/ROSIE#pose_bedRoom"/>
        <ROSIE1:name>Bed room</ROSIE1:name>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/ontologies/2024/8/ROSIE#beer1 -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/ontologies/2024/8/ROSIE#beer1">
        <rdf:type rdf:resource="http://www.semanticweb.org/ontologies/2024/8/ROSIE#ScenarioObject"/>
        <ROSIE1:isPositionedPElem rdf:resource="http://www.semanticweb.org/ontologies/2024/8/ROSIE#pose_beer1"/>
        <ROSIE1:description>Bottle of beer</ROSIE1:description>
        <ROSIE1:isDeformable rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</ROSIE1:isDeformable>
        <ROSIE1:name>Beer</ROSIE1:name>
        <ROSIE1:recognitionLevel rdf:datatype="http://www.w3.org/2001/XMLSchema#float">0.8</ROSIE1:recognitionLevel>
        <ROSIE1:shape>cylinder</ROSIE1:shape>
        <ROSIE1:weight rdf:datatype="http://www.w3.org/2001/XMLSchema#float">0.5</ROSIE1:weight>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/ontologies/2024/8/ROSIE#below -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/ontologies/2024/8/ROSIE#below">
        <rdf:type rdf:resource="http://www.semanticweb.org/ontologies/2024/8/ROSIE#QualitativePosKind"/>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/ontologies/2024/8/ROSIE#bhCountPeople -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/ontologies/2024/8/ROSIE#bhCountPeople">
        <rdf:type rdf:resource="http://www.semanticweb.org/ontologies/2024/8/ROSIE#ServiceRobotBehavior"/>
        <ROSIE1:coordenates rdf:resource="http://www.semanticweb.org/ontologies/2024/8/ROSIE#capturePicture"/>
        <ROSIE1:coordenates rdf:resource="http://www.semanticweb.org/ontologies/2024/8/ROSIE#count"/>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/ontologies/2024/8/ROSIE#bhGiveInformation -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/ontologies/2024/8/ROSIE#bhGiveInformation">
        <rdf:type rdf:resource="http://www.semanticweb.org/ontologies/2024/8/ROSIE#ServiceRobotBehavior"/>
        <ROSIE1:coordenates rdf:resource="http://www.semanticweb.org/ontologies/2024/8/ROSIE#speak"/>
    </owl:NamedIndividual>
    


    <!-- http://www.semanticweb.org/ontologies/2024/8/ROSIE#bhLearnFace -->

