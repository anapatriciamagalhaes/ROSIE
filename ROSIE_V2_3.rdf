<?xml version="1.0"?>
<rdf:RDF xmlns="http://www.semanticweb.org/ontologies/2024/8/ROSIE/"
     xml:base="http://www.semanticweb.org/ontologies/2024/8/ROSIE/"
     xmlns:owl="http://www.w3.org/2002/07/owl#"
     xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
     xmlns:xml="http://www.w3.org/XML/1998/namespace"
     xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
     xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
     xmlns:ROSIE="http://www.semanticweb.org/anapa/ontologies/2024/8/ROSIE#"
     xmlns:ROSIE1="http://www.semanticweb.org/ontologies/2024/8/ROSIE#"
     xmlns:ServiceRobot="http://www.semanticweb.org/anapa/ontologies/2024/8/ServiceRobot#">
    <owl:Ontology rdf:about="http://www.semanticweb.org/ontologies/2024/8/ROSIE"/>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Object Properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://www.semanticweb.org/ontologies/2024/8/ROSIE#categorizesCatObject -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/ontologies/2024/8/ROSIE#categorizesCatObject">
        <owl:inverseOf rdf:resource="http://www.semanticweb.org/ontologies/2024/8/ROSIE#isCategorizedCatObject"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/ontologies/2024/8/ROSIE#CategoryObject"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/ontologies/2024/8/ROSIE#ScenarioObject"/>
        <rdfs:comment>CategoryObject categorizesCatObject ScenarioObject</rdfs:comment>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/ontologies/2024/8/ROSIE#characterizes -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/ontologies/2024/8/ROSIE#characterizes">
        <owl:inverseOf rdf:resource="http://www.semanticweb.org/ontologies/2024/8/ROSIE#isCharacterizedAs"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/ontologies/2024/8/ROSIE#CategoryAgent"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/ontologies/2024/8/ROSIE#ScenarioAgent"/>
        <rdfs:comment>CategoryAgent characterizes ScenarioAgent</rdfs:comment>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/ontologies/2024/8/ROSIE#composes -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/ontologies/2024/8/ROSIE#composes">
        <owl:inverseOf rdf:resource="http://www.semanticweb.org/ontologies/2024/8/ROSIE#isStageOf"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/ontologies/2024/8/ROSIE#ComposedStep"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/ontologies/2024/8/ROSIE#Step"/>
        <rdfs:comment>ComposedStep composes Step</rdfs:comment>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/ontologies/2024/8/ROSIE#connectChild -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/ontologies/2024/8/ROSIE#connectChild">
        <owl:inverseOf rdf:resource="http://www.semanticweb.org/ontologies/2024/8/ROSIE#isChild"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/ontologies/2024/8/ROSIE#PartConnection"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/ontologies/2024/8/ROSIE#ServiceRobotPart"/>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/ontologies/2024/8/ROSIE#connectParent -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/ontologies/2024/8/ROSIE#connectParent">
        <owl:inverseOf rdf:resource="http://www.semanticweb.org/ontologies/2024/8/ROSIE#isParent"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/ontologies/2024/8/ROSIE#PartConnection"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/ontologies/2024/8/ROSIE#ServiceRobotPart"/>
        <rdfs:comment>PartConnection connectParent ServiceRobotPart</rdfs:comment>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/ontologies/2024/8/ROSIE#contains -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/ontologies/2024/8/ROSIE#contains">
        <owl:inverseOf rdf:resource="http://www.semanticweb.org/ontologies/2024/8/ROSIE#isContainedIn"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#InverseFunctionalProperty"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/ontologies/2024/8/ROSIE#Area"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/ontologies/2024/8/ROSIE#Element"/>
        <rdfs:comment>Area contains Element</rdfs:comment>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/ontologies/2024/8/ROSIE#coordenates -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/ontologies/2024/8/ROSIE#coordenates">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/ontologies/2024/8/ROSIE#ServiceRobotBehavior"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/ontologies/2024/8/ROSIE#PrimitiveSkill"/>
        <rdfs:comment>ServiceRobotBehavior coordenates PrimitiveSkill</rdfs:comment>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/ontologies/2024/8/ROSIE#grants -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/ontologies/2024/8/ROSIE#grants">
        <owl:inverseOf rdf:resource="http://www.semanticweb.org/ontologies/2024/8/ROSIE#isGrantedBy"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/ontologies/2024/8/ROSIE#PrivilegeKind"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/ontologies/2024/8/ROSIE#Person"/>
        <rdfs:comment>PrivilegeKind grants Person</rdfs:comment>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/ontologies/2024/8/ROSIE#hasComponent -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/ontologies/2024/8/ROSIE#hasComponent">
        <owl:inverseOf rdf:resource="http://www.semanticweb.org/ontologies/2024/8/ROSIE#isComponentOf"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#InverseFunctionalProperty"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/ontologies/2024/8/ROSIE#ServiceRobot"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/ontologies/2024/8/ROSIE#ServiceRobotPart"/>
        <rdfs:comment>ServiceRobot hasComponent ServceRobotPart</rdfs:comment>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/ontologies/2024/8/ROSIE#hasDomain -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/ontologies/2024/8/ROSIE#hasDomain">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/ontologies/2024/8/ROSIE#Requirement"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/ontologies/2024/8/ROSIE#RequirementDomainKind"/>
        <rdfs:comment>Requirement hasDomain RequirementDomainKing</rdfs:comment>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/ontologies/2024/8/ROSIE#hasGoal -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/ontologies/2024/8/ROSIE#hasGoal">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/ontologies/2024/8/ROSIE#Task"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/ontologies/2024/8/ROSIE#Goal"/>
        <rdfs:comment>Task hasGoal Goal</rdfs:comment>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/ontologies/2024/8/ROSIE#hasOrientation -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/ontologies/2024/8/ROSIE#hasOrientation">
        <owl:inverseOf rdf:resource="http://www.semanticweb.org/ontologies/2024/8/ROSIE#orients"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/ontologies/2024/8/ROSIE#Pose"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/ontologies/2024/8/ROSIE#OrientationMeasure"/>
        <rdfs:comment>Pose hasOrientation OrientationMeasure</rdfs:comment>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/ontologies/2024/8/ROSIE#hasPosition -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/ontologies/2024/8/ROSIE#hasPosition">
        <owl:inverseOf rdf:resource="http://www.semanticweb.org/ontologies/2024/8/ROSIE#positions"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/ontologies/2024/8/ROSIE#Pose"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/ontologies/2024/8/ROSIE#PositionMeasure"/>
        <rdfs:comment>Pose has PositionMeasure</rdfs:comment>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/ontologies/2024/8/ROSIE#hasSituation -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/ontologies/2024/8/ROSIE#hasSituation">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/ontologies/2024/8/ROSIE#ServiceRobot"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/ontologies/2024/8/ROSIE#StatusKind"/>
        <rdfs:comment>ServiceRobot hasSituation StatusKind</rdfs:comment>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/ontologies/2024/8/ROSIE#hasSubComponent -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/ontologies/2024/8/ROSIE#hasSubComponent">
        <owl:inverseOf rdf:resource="http://www.semanticweb.org/ontologies/2024/8/ROSIE#isSubComponentOf"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#InverseFunctionalProperty"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#AsymmetricProperty"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#IrreflexiveProperty"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/ontologies/2024/8/ROSIE#ServiceRobotPart"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/ontologies/2024/8/ROSIE#ServiceRobotPart"/>
        <rdfs:comment>ServiceRobotPart hasSubComponent ServiceRobotPart</rdfs:comment>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/ontologies/2024/8/ROSIE#hasType -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/ontologies/2024/8/ROSIE#hasType">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/ontologies/2024/8/ROSIE#Requirement"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/ontologies/2024/8/ROSIE#RequirementTypeKind"/>
        <rdfs:comment>Requirement hasType RequirementTypeKind</rdfs:comment>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/ontologies/2024/8/ROSIE#involvesAction -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/ontologies/2024/8/ROSIE#involvesAction">
        <owl:inverseOf rdf:resource="http://www.semanticweb.org/ontologies/2024/8/ROSIE#isActionOfContract"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/ontologies/2024/8/ROSIE#Contract"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/ontologies/2024/8/ROSIE#PrimitiveSkill"/>
        <rdfs:comment>Contract involvesAction PrimitiveSkill</rdfs:comment>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/ontologies/2024/8/ROSIE#involvesPart -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/ontologies/2024/8/ROSIE#involvesPart">
        <owl:inverseOf rdf:resource="http://www.semanticweb.org/ontologies/2024/8/ROSIE#isPartOfContract"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/ontologies/2024/8/ROSIE#Contract"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/ontologies/2024/8/ROSIE#ServiceRobotPart"/>
        <rdfs:comment>Contract involvesPart ServiceRobotPart</rdfs:comment>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/ontologies/2024/8/ROSIE#isAccessedBy -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/ontologies/2024/8/ROSIE#isAccessedBy">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/ontologies/2024/8/ROSIE#Area"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/ontologies/2024/8/ROSIE#Access"/>
        <rdfs:comment>Area isAccessedBy Access</rdfs:comment>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/ontologies/2024/8/ROSIE#isActionOfContract -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/ontologies/2024/8/ROSIE#isActionOfContract">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/ontologies/2024/8/ROSIE#PrimitiveSkill"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/ontologies/2024/8/ROSIE#Contract"/>
        <rdfs:comment>PrimitiveSkill isActionOfContract Contract</rdfs:comment>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/ontologies/2024/8/ROSIE#isCategorizedCatObject -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/ontologies/2024/8/ROSIE#isCategorizedCatObject">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/ontologies/2024/8/ROSIE#ScenarioObject"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/ontologies/2024/8/ROSIE#CategoryObject"/>
        <rdfs:comment>ScenarioObject isCategorizedCatObject CategoryObject</rdfs:comment>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/ontologies/2024/8/ROSIE#isCharacterizedAs -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/ontologies/2024/8/ROSIE#isCharacterizedAs">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/ontologies/2024/8/ROSIE#ScenarioAgent"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/ontologies/2024/8/ROSIE#CategoryAgent"/>
        <rdfs:comment>ScenarioAgent isCharacterizedAs CategoryAgent</rdfs:comment>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/ontologies/2024/8/ROSIE#isChild -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/ontologies/2024/8/ROSIE#isChild">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/ontologies/2024/8/ROSIE#ServiceRobotPart"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/ontologies/2024/8/ROSIE#PartConnection"/>
        <rdfs:comment>ServiceRobotPart isChild PartConnection</rdfs:comment>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/ontologies/2024/8/ROSIE#isComponentOf -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/ontologies/2024/8/ROSIE#isComponentOf">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/ontologies/2024/8/ROSIE#ServiceRobotPart"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/ontologies/2024/8/ROSIE#ServiceRobot"/>
        <rdfs:comment>ServiceRobotPart is ComponentOf ServiceRobot</rdfs:comment>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/ontologies/2024/8/ROSIE#isComposedOf -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/ontologies/2024/8/ROSIE#isComposedOf">
        <owl:inverseOf rdf:resource="http://www.semanticweb.org/ontologies/2024/8/ROSIE#isPartOf"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#InverseFunctionalProperty"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/ontologies/2024/8/ROSIE#Scenario"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/ontologies/2024/8/ROSIE#Area"/>
        <rdfs:comment>Scenario isComposedOf Area</rdfs:comment>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/ontologies/2024/8/ROSIE#isContainedIn -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/ontologies/2024/8/ROSIE#isContainedIn">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/ontologies/2024/8/ROSIE#Element"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/ontologies/2024/8/ROSIE#Area"/>
        <rdfs:comment>Element isContainedIn Area</rdfs:comment>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/ontologies/2024/8/ROSIE#isDescribedBy -->

