        <rdfs:domain rdf:resource="http://www.semanticweb.org/ontologies/2024/8/ROSIE#Capability"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/ontologies/2024/8/ROSIE#ServiceRobotBehavior"/>
        <rdfs:comment>Capability isImplementedAs ServiceRobotBehavior</rdfs:comment>
