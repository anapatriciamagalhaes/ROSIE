    <!-- http://www.semanticweb.org/ontologies/2024/8/ROSIE#isOrchestratedIn -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/ontologies/2024/8/ROSIE#isOrchestratedIn">
