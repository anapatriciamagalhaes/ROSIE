        <rdfs:range rdf:resource="http://www.semanticweb.org/ontologies/2024/8/ROSIE#PrivilegeKind"/>
        <rdfs:comment>Person isGrantedBy PrevilegeKind</rdfs:comment>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/ontologies/2024/8/ROSIE#isImplementedAs -->

