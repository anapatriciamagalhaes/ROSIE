        <rdfs:domain rdf:resource="http://www.semanticweb.org/ontologies/2024/8/ROSIE#Element"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/ontologies/2024/8/ROSIE#ExtraFeature"/>
        <rdfs:comment>Element isDescribedBy ExtraFeature</rdfs:comment>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/ontologies/2024/8/ROSIE#isDirectedBy -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/ontologies/2024/8/ROSIE#isDirectedBy">
