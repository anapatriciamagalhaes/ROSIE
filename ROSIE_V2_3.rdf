    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/ontologies/2024/8/ROSIE#faceRecognition">
        <rdf:type rdf:resource="http://www.semanticweb.org/ontologies/2024/8/ROSIE#Task"/>
        <ROSIE1:hasGoal rdf:resource="http://www.semanticweb.org/ontologies/2024/8/ROSIE#goalFC1"/>
        <ROSIE1:hasGoal rdf:resource="http://www.semanticweb.org/ontologies/2024/8/ROSIE#goalFC2"/>
